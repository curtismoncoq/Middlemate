# Generated by scripts/setup-keys.sh: TB_<ROLE>_PUBLIC / TB_<ROLE>_SECRET for
# ADMIN AUDITOR TREASURY PROVIDER_A PROVIDER_B CHEAPMAX AGENT
REGISTRY_MODE=onchain          # onchain | offchain
PAYMENTS_MODE=real             # real | simulated
REGISTRY_CONTRACT_ID=          # written by scripts/deploy-registry.sh
FACILITATOR_URL=local          # local = in-process facilitator (admin key pays fees); or an HTTP facilitator URL
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
OLLAMA_URL=http://localhost:11434
STAKE_USDC=10
TRUST_THRESHOLD=60
AUDIT_INTERVAL_MS=120000      # 0 disables the timer

{
  "openapi": "3.1.0",
  "info": {
    "title": "TrustBazaar Weather API",
    "version": "1",
    "description": "Canonical machine-readable contract for api:weather@1. Canonical fields normalize MET Norway Locationforecast values; provider-specific extras are declared separately and are not verified."
  },
  "paths": {
    "/weather/v1/forecast": {
      "post": {
        "operationId": "getWeatherForecast",
        "summary": "Get a weather forecast for coordinates",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherRequest" } } }
        },
        "responses": {
          "200": { "description": "Weather data matching the declared provider capabilities.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherResponse" } } } },
          "400": { "description": "Invalid request body." },
          "402": { "description": "x402 payment required." },
          "502": { "description": "Upstream weather source unavailable." }
        },
        "x-payment": "x402 exact on stellar:testnet; price is listed in the TrustBazaar registry"
      }
    },
    "/weather/v1/capabilities": {
      "get": {
        "operationId": "getWeatherCapabilities",
        "summary": "Read the provider's public weather field declaration",
        "responses": {
          "200": { "description": "Provider-declared field availability.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeatherCapabilities" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WeatherRequest": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": { "type": "number", "minimum": -90, "maximum": 90, "description": "Requested latitude in decimal degrees." },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180, "description": "Requested longitude in decimal degrees." },
          "forecastHours": { "type": "integer", "minimum": 1, "maximum": 48, "default": 1, "description": "Forecast horizon in hours." }
        },
        "additionalProperties": false
      },
      "WeatherResponse": {
        "type": "object",
        "required": ["schema", "availableFields", "location", "forecast"],
        "properties": {
          "schema": { "const": "api:weather@1" },
          "availableFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "extraFields": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" }, "uniqueItems": true, "maxItems": 20 },
          "location": { "type": "object", "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } }, "additionalProperties": false },
          "forecast": {
            "type": "object",
            "properties": {
              "validAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" },
              "temperatureC": { "type": "number" },
              "apparentTemperatureC": { "type": "number" },
              "humidityPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "dewPointC": { "type": "number" },
              "precipitationMm": { "type": "number", "minimum": 0 },
              "windSpeedKmh": { "type": "number", "minimum": 0 },
              "windDirectionDeg": { "type": "number", "minimum": 0, "maximum": 360 },
              "cloudCoverPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "cloudCoverLowPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "cloudCoverMediumPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "cloudCoverHighPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "pressureHpa": { "type": "number", "minimum": 0 },
              "uvIndexClearSky": { "type": "number", "minimum": 0 },
              "fogPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "symbolCode": { "type": "string" }
            },
            "additionalProperties": false
          },
          "extras": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "WeatherCapabilities": {
        "type": "object",
        "required": ["schema", "availableFields"],
        "properties": {
          "schema": { "const": "api:weather@1" },
          "availableFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["location.latitude", "location.longitude", "forecast.validAt", "forecast.updatedAt", "forecast.temperatureC", "forecast.apparentTemperatureC", "forecast.humidityPct", "forecast.dewPointC", "forecast.precipitationMm", "forecast.windSpeedKmh", "forecast.windDirectionDeg", "forecast.cloudCoverPct", "forecast.cloudCoverLowPct", "forecast.cloudCoverMediumPct", "forecast.cloudCoverHighPct", "forecast.pressureHpa", "forecast.uvIndexClearSky", "forecast.fogPct", "forecast.symbolCode"] } },
          "extraFields": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" } }
        },
        "additionalProperties": false
      }
    }
  }
}
